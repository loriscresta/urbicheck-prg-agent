__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.egg-info/
dist/
build/

# Shapefile grandi — scaricati a runtime da Geoportale Piemonte
# (i comuni già caricati nel repo sono eccezioni esplicite sotto)
data/**/*.shp
data/**/*.dbf
data/**/*.sbn
data/**/*.sbx
data/**/*.cpg

# Comuni inclusi direttamente nel repo (shapefile nell'immagine Docker)
!data/ALESSANDRIA/*.shp
!data/ALESSANDRIA/*.dbf
!data/ALESSANDRIA/*.prj
!data/ALESSANDRIA/*.shx

# File temporanei
*.tmp
*.bak
